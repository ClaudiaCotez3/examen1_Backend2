# Copy to .env and adjust if needed. NEVER commit real secrets to this file.
MONGODB_URI=mongodb://localhost:27017/workflow_engine
JWT_SECRET=ZGV2LXdvcmtmbG93LWVuZ2luZS1zZWNyZXQta2V5LWNoYW5nZS1tZS1pbi1wcm9k
JWT_ISSUER=workflow-engine
PORT=8001

# Anthropic Claude — required for the policy-designer AI assistant.
# Get one from https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=ANTHROPIC_API_KEY=your_anthropic_api_key_here
# Cheap + fast for everyday designer prompts. Bump to claude-sonnet-4-5
# if you start asking for very complex BPMN graphs.
ANTHROPIC_MODEL=claude-haiku-4-5

# Motor inteligente de enrutamiento y riesgos (TensorFlow).
# Carpeta donde train_models.py guarda los modelos .keras + encoders.
MODELS_DIR=models
